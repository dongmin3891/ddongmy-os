# Notion server-only configuration
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
NOTION_WEBHOOK_VERIFICATION_TOKEN=

# Cloudflare R2 server-only configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ddongmy-assets
R2_PUBLIC_URL=https://cdn.ddongmy.com

# Optional Netdata Agent connection for /lab server metrics
NETDATA_BASE_URL=
# Override when the root filesystem uses a different chart ID
NETDATA_ROOT_DISK_CHART=disk_space./
# Hardware-specific CPU package temperature chart ID
NETDATA_TEMPERATURE_CHART=

# Optional local status-exporter connection; Kubernetes uses the ClusterIP Service
STATUS_EXPORTER_BASE_URL=
